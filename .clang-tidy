---
# Static-analysis policy for Helix. Every enabled check is enforced
# (WarningsAsErrors: '*'); every disabled check below has a reason.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-braces-around-statements,
  readability-duplicate-include,
  readability-else-after-return,
  readability-implicit-bool-conversion,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-simplify-boolean-expr,
  readability-string-compare,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-narrowing-conversions,
  -cert-err33-c,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-msc24-c,
  -cert-msc33-c,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-optin.performance.Padding,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-unused-parameters,
  -concurrency-mt-unsafe
WarningsAsErrors: '*'
HeaderFilterRegex: '(src|tests|tools)/.*\.h$'
FormatStyle: none
CheckOptions:
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: false
  - key: bugprone-suspicious-string-compare.WarnOnImplicitComparison
    value: true
# Rationale for disabled checks:
#  bugprone-easily-swappable-parameters : noisy for (const void*, size_t, ...) C APIs.
#  bugprone-reserved-identifier / cert-dcl37-c / cert-dcl51-cpp : false positives on _GNU_SOURCE.
#  bugprone-narrowing-conversions       : duplicates -Wconversion, which the compiler already enforces.
#  cert-err33-c                         : would require checking every printf/fprintf/snprintf; the
#                                         few places where it matters (syscalls) are checked by hand.
#  cert-msc24-c / cert-msc33-c          : flag standard-library functions we use deliberately.
#  clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling : suggests Annex K (not in glibc).
#  clang-analyzer-optin.performance.Padding : struct layout is not a bottleneck here.
#  misc-include-cleaner                 : fights with the project's explicit include style.
#  misc-no-recursion                    : nftw callbacks in tests are not recursive code of ours.
#  misc-unused-parameters               : callback signatures (nftw, signal handlers) are fixed.
#  concurrency-mt-unsafe                : the design is single-owner-per-thread by construction (ADR-003).
...
